---
import { ClientRouter } from 'astro:transitions';
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';
import '@fontsource-variable/lora';
import '../styles/tokens.css';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../config/site';
import { i18nInitScript } from '../i18n/translations';

interface Props {
  title?: string;
  description?: string;
  /** Path to a share image (e.g. an optimized photo); defaults to the site card */
  ogImage?: string;
}

const { title, description = site.description, ogImage } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : site.name;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImageAbs = Astro.site
  ? new URL(ogImage ?? '/og-default.jpg', Astro.site).href
  : (ogImage ?? '/og-default.jpg');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImageAbs} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    <ClientRouter />
    <style is:inline define:vars={{
      themeBg: site.theme?.bg || '#FAF7F2',
      themeDark: site.theme?.dark || '#1E2E2D',
      themePrimary: site.theme?.primary || '#00706E',
      themeSecondary: site.theme?.secondary || '#A23B24',
      themeAccent: site.theme?.accent || '#00A3A0',
    }}>
      :root {
        --color-cream: var(--themeBg);
        --color-ebony: var(--themeDark);
        --color-coffee: var(--themePrimary);
        --color-olive: var(--themeSecondary);
        --color-camel: var(--themeAccent);
      }
    </style>
    <script is:inline set:html={i18nInitScript} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />

    <script>
      function initScrollReveal() {
        const motionOK = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;
        if (motionOK && 'IntersectionObserver' in window) {
          const sections = [...document.querySelectorAll('main .section')].slice(1);
          let fired = false;
          const io = new IntersectionObserver(
            (entries) => {
              fired = true;
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  io.unobserve(entry.target);
                }
              }
            },
            { rootMargin: '0px 0px -12% 0px', threshold: 0 }
          );
          for (const el of sections) {
            el.classList.add('reveal');
            io.observe(el);
          }
          setTimeout(() => {
            if (!fired) {
              io.disconnect();
              for (const el of sections) el.classList.add('is-visible');
            }
          }, 1500);
        }
      }

      document.addEventListener('astro:page-load', initScrollReveal);
    </script>
  </body>
</html>
