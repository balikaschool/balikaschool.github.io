---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
import { mdToHtml } from '../utils/markdown';

const { about } = site.copy;

const allSections = await getCollection('about');
const sections = allSections.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={about.title}>
  <section class="section">
    <div class="container about-inner">
      <div class="about-text">
        <h1>
          {about.title ? (
            <>
              <span class="text-ne">{about.titleNe}</span>
              <span class="text-en" style="display:none;">{about.title}</span>
            </>
          ) : (
            <span class="text-always">{about.titleNe}</span>
          )}
        </h1>
        <p class="about-intro">
          {about.intro ? (
            <>
              <span class="text-ne">{about.introNe}</span>
              <span class="text-en" style="display:none;">{about.intro}</span>
            </>
          ) : (
            <span class="text-always">{about.introNe}</span>
          )}
        </p>

        {sections.map((section) => {
          const { title_ne, title_en, enable_en, body_en } = section.data;
          const htmlNe = mdToHtml(section.body || '');
          const hasEn = Boolean(enable_en && (title_en || body_en));
          const htmlEn = hasEn ? mdToHtml(body_en || section.body || '') : '';

          return (
            <section class="about-section">
              <h2>
                {hasEn && title_en ? (
                  <>
                    <span class="text-ne">{title_ne}</span>
                    <span class="text-en" style="display:none;">{title_en}</span>
                  </>
                ) : (
                  <span class="text-always">{title_ne}</span>
                )}
              </h2>
              <div class="about-section-content">
                {hasEn && htmlEn ? (
                  <>
                    <div class="body-ne" set:html={htmlNe} />
                    <div class="body-en" style="display:none;" set:html={htmlEn} />
                  </>
                ) : (
                  <div class="body-always" set:html={htmlNe} />
                )}
              </div>
            </section>
          );
        })}
      </div>

      <aside class="about-media">
        {sections.filter((s) => s.data.photo).map((section) => {
          const { photo, caption_ne, caption_en, enable_en, title_ne } = section.data;
          const hasCapEn = Boolean(enable_en && caption_en);
          return (
            <figure>
              <Image
                src={photo!}
                alt={caption_ne || title_ne}
                width={640}
                class="about-photo"
              />
              {(caption_ne || (hasCapEn && caption_en)) && (
                <figcaption>
                  {hasCapEn ? (
                    <>
                      <span class="caption-ne">{caption_ne}</span>
                      <span class="caption-en" style="display:none;">{caption_en}</span>
                    </>
                  ) : (
                    <span class="caption-always">{caption_ne}</span>
                  )}
                </figcaption>
              )}
            </figure>
          );
        })}
      </aside>
    </div>
  </section>
</BaseLayout>

<script>
  function syncAboutLanguage() {
    const lang = localStorage.getItem('balika_lang') || 'ne';
    document.querySelectorAll('.about-inner').forEach((container) => {
      container.querySelectorAll('.text-ne, .body-ne, .caption-ne').forEach((el) => {
        (el as HTMLElement).style.display = lang === 'ne' ? '' : 'none';
      });
      container.querySelectorAll('.text-en, .body-en, .caption-en').forEach((el) => {
        (el as HTMLElement).style.display = lang === 'en' ? '' : 'none';
      });
    });
  }

  document.addEventListener('DOMContentLoaded', syncAboutLanguage);
  document.addEventListener('astro:page-load', syncAboutLanguage);
  window.addEventListener('languageChange', syncAboutLanguage);
</script>

<style>
  .about-inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-5);
    align-items: start;
  }

  .about-text p {
    margin-top: var(--space-3);
  }

  .about-intro {
    font-size: 1.15rem;
  }

  .about-section {
    margin-top: var(--space-5);
  }

  .about-section h2 {
    margin-bottom: var(--space-2);
  }

  .about-section-content {
    line-height: 1.7;
  }

  .about-section-content :global(p) {
    margin-top: var(--space-3);
  }

  .about-section-content :global(ul) {
    margin-top: var(--space-2);
    padding-left: var(--space-4);
  }

  .about-section-content :global(li) {
    margin-top: var(--space-1);
  }

  .about-media {
    display: grid;
    gap: var(--space-4);
    position: sticky;
    top: var(--space-4);
  }

  .about-photo {
    width: 100%;
    height: auto;
    border-radius: var(--radius-card);
    border: var(--border-hairline);
  }

  figure {
    margin: 0;
  }

  figcaption {
    font-size: 0.9rem;
    margin-top: var(--space-2);
  }

  @media (max-width: 800px) {
    .about-inner {
      grid-template-columns: 1fr;
    }

    .about-media {
      position: static;
    }
  }
</style>
