---
import { Image, getImage } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GalleryGrid from '../../components/GalleryGrid.astro';
import { formatBsDate } from '../../utils/dateConverter';

export async function getStaticPaths() {
  const entries = await getCollection('notices');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const bsEn = formatBsDate(d.date, 'en', false);
const bsNe = formatBsDate(d.date, 'ne', false);
const catI18nKey = `cat.${d.category.toLowerCase()}`;

const { Content } = await render(entry);

const ogPhoto = d.photo
  ? await getImage({ src: d.photo, width: 1200, format: 'jpeg' })
  : undefined;
---

<BaseLayout title={d.title} description={`${d.title} — ${d.category}`} ogImage={ogPhoto?.src}>
  <section class="section">
    <div class="container">
      <a class="back-link" href="/notices">← All notices</a>
      <div class={d.photo ? "detail-grid" : "detail-grid detail-grid--text-only"}>
        {
          d.photo && (
            <div class="detail-media">
              <Image
                src={d.photo}
                alt={d.title}
                width={1000}
                widths={[480, 800, 1000]}
                sizes="(max-width: 800px) 92vw, 40vw"
                loading="eager"
                fetchpriority="high"
                class="detail-photo"
              />
            </div>
          )
        }
        <div class="detail-info">
          <h1>{d.title}</h1>
          <p class="meta">
            <span class="pill" data-i18n={catI18nKey}>{d.category}</span>
            <time datetime={d.date.toISOString().slice(0, 10)}>
              <span class="bs-date-en">{bsEn}</span>
              <span class="bs-date-ne" style="display:none;">{bsNe}</span>
            </time>
          </p>
          {d.pinned && (
            <p>
              <span class="pill pill--pinned">
                <span class="bs-date-en">Featured Notice</span>
                <span class="bs-date-ne" style="display:none;">मुख्य सूचना</span>
              </span>
            </p>
          )}
          <div class="notice-body">
            <Content />
          </div>
          {d.attachments && d.attachments.length > 0 && (
            <div class="attachments">
              <h2 class="attachments-heading">
                <span class="attach-en">Attachments</span>
                <span class="attach-ne" style="display:none;">संलग्न फाइलहरू</span>
              </h2>
              <ul class="attachment-list">
                {d.attachments.map(({ label, file }) => {
                  const filename = file.split('/').pop() ?? file;
                  const displayName = label || filename;
                  return (
                    <li class="attachment-item">
                      <a href={file} download class="attachment-link">
                        <svg class="attach-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                          <polyline points="7 10 12 15 17 10"/>
                          <line x1="12" y1="15" x2="12" y2="3"/>
                        </svg>
                        <span class="attach-name">{displayName}</span>
                        <span class="attach-ext">{filename.split('.').pop()?.toUpperCase()}</span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          )}
        </div>
      </div>
      {d.gallery && d.gallery.length > 0 && <GalleryGrid images={d.gallery} name={d.title} />}
    </div>
  </section>
</BaseLayout>

<script>
  function syncNoticeDetailDate() {
    const lang = localStorage.getItem('balika_lang') || 'ne';
    document.querySelectorAll('.bs-date-en, .attach-en').forEach(el => {
      (el as HTMLElement).style.display = lang === 'en' ? 'inline' : 'none';
    });
    document.querySelectorAll('.bs-date-ne, .attach-ne').forEach(el => {
      (el as HTMLElement).style.display = lang === 'ne' ? 'inline' : 'none';
    });
  }

  document.addEventListener('DOMContentLoaded', syncNoticeDetailDate);
  document.addEventListener('astro:page-load', syncNoticeDetailDate);
  window.addEventListener('languageChange', syncNoticeDetailDate);
</script>

<style>
  .back-link {
    display: inline-block;
    margin-bottom: var(--space-4);
    font-weight: 600;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: var(--space-5);
    align-items: start;
  }

  .detail-grid--text-only {
    grid-template-columns: 1fr;
    max-width: 46rem;
  }

  @media (max-width: 800px) {
    .detail-grid {
      grid-template-columns: 1fr;
    }
  }

  .detail-media {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }

  .detail-photo {
    width: 100%;
    height: auto;
    border-radius: var(--radius-card);
    border: var(--border-hairline);
  }

  .detail-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .meta {
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .notice-body {
    line-height: 1.7;
  }

  .notice-body p {
    margin-bottom: var(--space-3);
  }

  /* ── Attachments ─────────────────────────────────────────── */
  .attachments {
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: var(--border-hairline);
  }

  .attachments-heading {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-muted, #666);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 var(--space-3);
  }

  .attachment-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .attachment-link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.55rem 1rem;
    background: color-mix(in srgb, var(--accent) 8%, var(--color-white));
    border: 1px solid color-mix(in srgb, var(--accent) 20%, transparent);
    border-radius: var(--radius-card);
    color: var(--text-body);
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    transition: background 160ms ease, border-color 160ms ease, transform 160ms ease;
    max-width: 100%;
  }

  .attachment-link:hover {
    background: color-mix(in srgb, var(--accent) 15%, var(--color-white));
    border-color: var(--accent);
    transform: translateX(3px);
    color: var(--accent);
  }

  .attach-icon {
    width: 1.1rem;
    height: 1.1rem;
    flex-shrink: 0;
    color: var(--accent);
  }

  .attach-name {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .attach-ext {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.15em 0.5em;
    background: var(--accent);
    color: var(--color-white);
    border-radius: 4px;
    flex-shrink: 0;
    letter-spacing: 0.04em;
  }
</style>
